<?xml version="1.0" encoding="UTF-8"?>
<!-- =========================================================================
     HUMAN: A printable Gratuity Distribution slip per event - employee, date,
     role, hours worked, and gratuity share - to hand to payroll / attach to a
     check for staff who don't normally receive gratuity.
     AI: qweb-pdf on project.task. Self-contained inline-style layout with its
     own lodge header (NOT web.external_layout, which imposed the default
     "Your logo / My Company" header and a font that clipped bold glyphs).
     ASCII-only text so no engine mojibakes it. Print from the event's Print
     menu.
     ========================================================================= -->
<odoo>
    <record id="action_report_event_gratuity" model="ir.actions.report">
        <field name="name">Gratuity Distribution</field>
        <field name="model">project.task</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">elksevent.report_event_gratuity</field>
        <field name="report_file">elksevent.report_event_gratuity</field>
        <field name="paperformat_id" ref="base.paperformat_us"/>
        <field name="print_report_name">'Gratuity - %s' % (object.name or 'Event')</field>
    </record>

    <template id="report_event_gratuity">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="settings"
                   t-value="doc.env['elks.lodge.settings'].sudo().search([], limit=1)"/>
                <div class="page" style="font-size:11px; color:#222;">

                    <!-- Lodge header -->
                    <table style="width:100%; border:none; margin-bottom:4px;">
                        <tr>
                            <td style="border:none; padding:0;">
                                <div style="font-size:15px; font-weight:bold;">
                                    <t t-if="settings"><t t-esc="settings.name"/></t>
                                    <t t-else="">Elks Lodge</t>
                                    <t t-if="settings and settings.lodge_number">#<t t-esc="settings.lodge_number"/></t>
                                </div>
                                <div style="font-size:13px; font-weight:bold; color:#46166a;">
                                    Gratuity Distribution
                                </div>
                            </td>
                            <td style="border:none; padding:0; text-align:right; font-size:9px; color:#666;">
                                Printed <span t-esc="time.strftime('%m/%d/%Y')"/>
                            </td>
                        </tr>
                    </table>
                    <hr style="border-top:2px solid #46166a; margin:2px 0 10px 0;"/>

                    <table style="width:100%; font-size:10px; margin-bottom:10px;">
                        <tr>
                            <td style="padding:2px 4px;"><strong>Event:</strong> <t t-esc="doc.name or ''"/></td>
                            <td style="padding:2px 4px;"><strong>Event Date:</strong>
                                <t t-if="doc.x_event_date"><span t-field="doc.x_event_date"/></t>
                            </td>
                        </tr>
                    </table>

                    <t t-set="callouts" t-value="doc.x_callout_ids.filtered(lambda c: c.state == 'certified' and (c.gratuity or c.gratuity_distributed))"/>
                    <t t-if="not callouts">
                        <p style="font-size:11px;"><em>No gratuity has been recorded on this event's certified call-outs yet.</em></p>
                    </t>
                    <t t-set="grand" t-value="0.0"/>
                    <t t-foreach="callouts" t-as="co">
                        <t t-set="grand" t-value="grand + co.gratuity_distributed"/>
                        <div style="background:#46166a; color:#fff; font-weight:bold; padding:4px 8px; margin-top:8px;">
                            <t t-esc="co.department_label"/> - Manager: <t t-esc="co.manager_partner_id.name or '-'"/>
                        </div>
                        <table style="width:100%; border-collapse:collapse; font-size:10px; border:1px solid #ccc; border-top:none; margin-bottom:6px;">
                            <thead>
                                <tr style="background:#f4f0f8;">
                                    <th style="padding:4px 8px; text-align:left;">Employee / Name</th>
                                    <th style="padding:4px 8px; text-align:left;">Role / Shift</th>
                                    <th style="padding:4px 8px; text-align:right;">Hours</th>
                                    <th style="padding:4px 8px; text-align:right;">Gratuity</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="co.line_ids.filtered(lambda l: l.gratuity_share)" t-as="ln">
                                    <td style="padding:4px 8px; border-bottom:1px solid #eee;"><t t-esc="ln.employee_id.name or ln.person_name or '-'"/></td>
                                    <td style="padding:4px 8px; border-bottom:1px solid #eee;"><t t-esc="ln.role or ''"/><t t-if="ln.start_str"> (<t t-esc="ln.start_str"/><t t-if="ln.end_str">-<t t-esc="ln.end_str"/></t>)</t></td>
                                    <td style="padding:4px 8px; text-align:right; border-bottom:1px solid #eee;"><t t-esc="'%g' % (ln.hours or 0)"/></td>
                                    <td style="padding:4px 8px; text-align:right; border-bottom:1px solid #eee;">$<t t-esc="'{:,.2f}'.format(ln.gratuity_share or 0.0)"/></td>
                                </tr>
                                <tr t-if="not co.line_ids.filtered(lambda l: l.gratuity_share)">
                                    <td colspan="4" style="padding:4px 8px; color:#a11;"><em>Pool $<t t-esc="'{:,.2f}'.format(co.gratuity)"/> not yet disbursed per person by the manager.</em></td>
                                </tr>
                                <tr style="background:#efe9f5; font-weight:bold;">
                                    <td colspan="3" style="padding:4px 8px; text-align:right;">
                                        Pool $<t t-esc="'{:,.2f}'.format(co.gratuity)"/> /
                                        Assigned
                                    </td>
                                    <td style="padding:4px 8px; text-align:right;">$<t t-esc="'{:,.2f}'.format(co.gratuity_distributed)"/></td>
                                </tr>
                                <tr t-if="abs(co.gratuity_remaining) &gt; 0.005">
                                    <td colspan="3" style="padding:2px 8px; text-align:right; color:#a11;">Unassigned remaining</td>
                                    <td style="padding:2px 8px; text-align:right; color:#a11;">$<t t-esc="'{:,.2f}'.format(co.gratuity_remaining)"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </t>

                    <table style="width:100%; border-collapse:collapse; font-size:11px; margin-top:6px;">
                        <tr style="background:#46166a; color:#fff; font-weight:bold;">
                            <td style="padding:5px 8px; text-align:right;">TOTAL GRATUITY DISBURSED</td>
                            <td style="padding:5px 8px; text-align:right; width:20%;">$<t t-esc="'{:,.2f}'.format(grand)"/></td>
                        </tr>
                    </table>

                    <p style="font-size:9px; color:#888; margin-top:10px;">
                        Each department manager assigns their gratuity pool across
                        their certified roster on the call-out sheet. This slip
                        records the amount owed to each person for payroll, so
                        disbursement can proceed even if the manager is unavailable.
                    </p>
                </div>
            </t>
        </t>
    </template>
</odoo>
