<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Facility Usage Agreement (customer contract) bound to the event -->
    <record id="action_report_event_contract" model="ir.actions.report">
        <field name="name">Facility Usage Agreement</field>
        <field name="model">project.task</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">elksevent.report_event_contract</field>
        <field name="report_file">elksevent.report_event_contract</field>
        <field name="paperformat_id" ref="paperformat_event_sheet"/>
    </record>

    <template id="report_event_contract">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="settings"
                   t-value="o.env['elks.lodge.settings'].sudo().search([], limit=1)"/>
                <t t-set="so" t-value="o.x_sale_order_id"/>
                <t t-set="net" t-value="o.x_total_billed or 0.0"/>
                <t t-set="tax" t-value="o.x_event_tax_amount or 0.0"/>
                <t t-set="grand" t-value="o.x_event_grand_total or (net + tax)"/>
                <t t-set="dep_pct"
                   t-value="(settings.x_deposit_pct if settings else 50.0) or 0.0"/>
                <t t-set="deposit" t-value="grand * dep_pct / 100.0"/>
                <t t-set="dep_received" t-value="o.x_deposit_received"/>
                <t t-set="dep_paid" t-value="(o.x_deposit_amount or deposit) if dep_received else 0.0"/>
                <!-- Terms &amp; Conditions live on the editable T&amp;C page; the
                     agreement links to it (settings URL or the /event-terms page)
                     so the printed terms are never a hardcoded duplicate. -->
                <t t-set="terms_url"
                   t-value="settings.x_event_terms_url if settings and settings.x_event_terms_url else ((o.env['ir.config_parameter'].sudo().get_param('web.base.url') or '').rstrip('/') + '/event-terms')"/>
                <t t-set="terms_label"
                   t-value="settings.x_event_terms_label if settings and settings.x_event_terms_label else 'Rental Terms &amp; Conditions'"/>
                <div class="page" style="font-size:13px;">

                    <!-- ===== LODGE HEADER WITH LOGOS (P&amp;L style) ===== -->
                    <table style="width:100%; margin-bottom:6px; border:none;">
                        <tr>
                            <td style="width:15%; text-align:center; vertical-align:middle; border:none; padding:0;">
                                <t t-if="settings and settings.logo_primary">
                                    <img t-att-src="image_data_uri(settings.logo_primary)"
                                         style="max-height:80px; max-width:100px;" alt="Elks USA"/>
                                </t>
                            </td>
                            <td style="text-align:center; vertical-align:middle; border:none;">
                                <div t-if="settings" style="font-size:19px; font-weight:bold;">
                                    <t t-esc="settings.name"/>
                                    <t t-if="settings.lodge_number">#<t t-esc="settings.lodge_number"/></t>
                                </div>
                                <div style="font-size:16px; font-weight:bold; margin-top:2px;">Facility Usage Agreement</div>
                                <div t-if="settings" style="font-size:12px; color:#555; margin-top:2px;">
                                    <t t-esc="settings.lodge_address or ''"/>,
                                    <t t-esc="settings.lodge_city or ''"/>
                                    <t t-esc="settings.lodge_state or ''"/>
                                </div>
                            </td>
                            <td style="width:15%; text-align:center; vertical-align:middle; border:none; padding:0;">
                                <t t-if="settings and settings.logo_lodge">
                                    <img t-att-src="image_data_uri(settings.logo_lodge)"
                                         style="max-height:80px; max-width:100px;" alt="Lodge Logo"/>
                                </t>
                            </td>
                        </tr>
                    </table>
                    <hr style="border-top:2px solid #46166a; margin:4px 0 12px 0;"/>

                    <!-- Retainer PAID stamp -->
                    <div t-if="dep_received" style="border:2px solid #0a7a24; color:#0a7a24; font-weight:bold; text-align:center; padding:6px; margin-bottom:12px; font-size:14px;">
                        RETAINER / RESERVATION FEE PAID - $<t t-esc="'{:,.2f}'.format(dep_paid)"/><t t-if="o.x_deposit_date"> on <span t-field="o.x_deposit_date" t-options='{"widget":"date"}'/></t>
                    </div>

                    <!-- Event particulars -->
                    <!-- Event name banner so the host sees exactly which
                         booking this agreement is for (e.g. "Chatfield
                         Wedding Reception"). Sits above the tabular
                         host/date/phone details. -->
                    <div style="text-align:center; font-size:15px; font-weight:bold; margin-bottom:8px;">
                        <t t-esc="o.name or ''"/>
                    </div>
                    <table style="width:100%; font-size:12px; margin-bottom:12px;">
                        <tr>
                            <td style="padding:3px;"><strong>Host:</strong> <t t-esc="o.x_customer_name or ''"/></td>
                            <td style="padding:3px;"><strong>Type:</strong> <span t-field="o.x_event_type"/></td>
                        </tr>
                        <tr>
                            <td style="padding:3px;"><strong>Event Date:</strong> <t t-esc="o.x_event_date or ''"/></td>
                            <td style="padding:3px;"><strong>Guests:</strong> <t t-esc="o.x_guest_count or 0"/></td>
                        </tr>
                        <!-- Event window (start / end wall-clock times).
                             Use the *_text fields when populated (already
                             formatted "9:00 PM") and fall back to the
                             float hour display. Duration lets the host
                             see the length of the rental at a glance. -->
                        <tr>
                            <td style="padding:3px;">
                                <strong>Event Time:</strong>
                                <t t-esc="o.x_event_start_time_text or ''"/>
                                <t t-if="o.x_event_end_time_text">
                                    &#8211; <t t-esc="o.x_event_end_time_text"/>
                                </t>
                            </td>
                            <td style="padding:3px;">
                                <t t-if="o.x_event_duration">
                                    <strong>Duration:</strong>
                                    <t t-esc="'{:.2f}'.format(o.x_event_duration)"/> hrs
                                </t>
                            </td>
                        </tr>
                        <!-- Access windows so the customer sees the
                             setup, entry, and cleanup times printed on
                             the signed contract. Rows only render when
                             a value is present so a bare "8:00 AM" line
                             for setup won't appear when unused. -->
                        <tr t-if="o.x_requested_setup or o.x_requested_entry">
                            <td style="padding:3px;">
                                <t t-if="o.x_requested_setup">
                                    <strong>Setup:</strong>
                                    <span t-field="o.x_requested_setup"
                                          t-options='{"widget":"datetime"}'/>
                                </t>
                            </td>
                            <td style="padding:3px;">
                                <t t-if="o.x_requested_entry">
                                    <strong>Entry:</strong>
                                    <span t-field="o.x_requested_entry"
                                          t-options='{"widget":"datetime"}'/>
                                </t>
                            </td>
                        </tr>
                        <tr t-if="o.x_cleanup_datetime">
                            <td style="padding:3px;" colspan="2">
                                <strong>Cleanup:</strong>
                                <span t-field="o.x_cleanup_datetime"
                                      t-options='{"widget":"datetime"}'/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:3px;"><strong>Phone:</strong> <t t-esc="o.x_customer_phone or ''"/></td>
                            <td style="padding:3px;"><strong>Email:</strong> <t t-esc="o.x_customer_email or ''"/></td>
                        </tr>
                        <tr t-if="o.x_is_member">
                            <td style="padding:3px;" colspan="2">
                                <strong>Member #:</strong> <t t-esc="o.x_member_number or ''"/>
                            </td>
                        </tr>
                    </table>

                    <!-- Charges -->
                    <table style="width:100%; border-collapse:collapse; font-size:12px; margin-bottom:12px;">
                        <thead>
                            <tr style="background:#46166a; color:white;">
                                <th style="padding:6px; text-align:left;">Item</th>
                                <th style="padding:6px; text-align:right;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="so">
                                <t t-foreach="so.order_line.filtered(lambda l: not l.display_type)" t-as="line">
                                    <tr>
                                        <td style="padding:6px; border-bottom:1px solid #ddd;"><t t-esc="line.name"/></td>
                                        <td style="padding:6px; text-align:right; border-bottom:1px solid #ddd;">$<t t-esc="'{:,.2f}'.format(line.price_subtotal)"/></td>
                                    </tr>
                                </t>
                            </t>
                            <t t-else="">
                                <t t-foreach="o.x_room_booking_ids" t-as="rb">
                                    <tr>
                                        <td style="padding:6px; border-bottom:1px solid #ddd;">Room: <t t-esc="rb.room_id.name"/></td>
                                        <td style="padding:6px; text-align:right; border-bottom:1px solid #ddd;">$<t t-esc="'{:,.2f}'.format(rb.subtotal)"/></td>
                                    </tr>
                                </t>
                            </t>
                            <tr>
                                <td style="padding:6px; text-align:right;">Subtotal (pre-tax):</td>
                                <td style="padding:6px; text-align:right;">$<t t-esc="'{:,.2f}'.format(net)"/></td>
                            </tr>
                            <tr t-if="tax">
                                <td style="padding:6px; text-align:right;">Tax:</td>
                                <td style="padding:6px; text-align:right;">$<t t-esc="'{:,.2f}'.format(tax)"/></td>
                            </tr>
                            <tr style="background:#e8e0f0; font-weight:bold;">
                                <td style="padding:6px; text-align:right;">Total:</td>
                                <td style="padding:6px; text-align:right;">$<t t-esc="'{:,.2f}'.format(grand)"/></td>
                            </tr>
                            <tr>
                                <td style="padding:6px; text-align:right;">Reservation Fee due at signing (<t t-esc="'{:g}'.format(dep_pct)"/>%):</td>
                                <td style="padding:6px; text-align:right;">
                                    $<t t-esc="'{:,.2f}'.format(deposit)"/>
                                    <t t-if="dep_received">
                                        <span style="color:#0a7a24; font-weight:bold; margin-left:6px;">- PAID<t t-if="o.x_deposit_date"> <span t-field="o.x_deposit_date" t-options='{"widget":"date"}'/></t></span>
                                    </t>
                                </td>
                            </tr>
                            <tr t-if="dep_received">
                                <td style="padding:6px; text-align:right;">Retainer received:</td>
                                <td style="padding:6px; text-align:right; color:#0a7a24; font-weight:bold;">-$<t t-esc="'{:,.2f}'.format(dep_paid)"/></td>
                            </tr>
                            <tr style="font-weight:bold;">
                                <td style="padding:6px; text-align:right;">Balance due before event:</td>
                                <td style="padding:6px; text-align:right;">$<t t-esc="'{:,.2f}'.format(grand - (dep_paid if dep_received else deposit))"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Payment &amp; cancellation + Terms reference -->
                    <div style="font-size:12px; line-height:1.4;">
                        <strong>PAYMENT &amp; CANCELLATION</strong>
                        <ul style="margin:4px 0 8px 18px; padding:0;">
                            <li>A non-refundable cleaning fee of $100.00 is due and payable at the time of signing.</li>
                            <li>All other fees: 50% due at signing, with the remaining balance due the day prior to the scheduled event.</li>
                            <li>Cancellation of the event within seven (7) days will forfeit 100% of the reservation fees.</li>
                        </ul>

                        <strong>TERMS &amp; CONDITIONS</strong>
                        <!-- Live body pulled from the editable /event-terms
                             website page; falls back to the settings note or a
                             reference link if the page is unavailable. -->
                        <t t-set="terms_body" t-value="o._event_terms_body_html()"/>
                        <t t-if="terms_body">
                            <div style="font-size:11px; line-height:1.35;" t-out="terms_body"/>
                            <p style="margin:6px 0 0 0; font-size:11px;">
                                By signing below, the Host acknowledges having read,
                                understood, and agreed to the Terms &amp; Conditions
                                above (also published at
                                <a t-att-href="terms_url" style="color:#46166a;"><t t-esc="terms_label"/></a>),
                                in effect as of the signing date. These terms may be
                                updated from time to time.
                            </p>
                        </t>
                        <t t-elif="settings and settings.x_event_contract_terms">
                            <div style="margin:4px 0 0 0;" t-out="settings.x_event_contract_terms"/>
                            <p style="margin:4px 0 0 0;">
                                Full Terms &amp; Conditions:
                                <a t-att-href="terms_url" style="color:#46166a;"><t t-esc="terms_label"/></a>
                            </p>
                        </t>
                        <t t-else="">
                            <p style="margin:4px 0 0 0;">
                                The full Rental Terms &amp; Conditions - rules of usage,
                                insurance, alcohol and catering policy, setup/takedown
                                charges, indemnification, and capacity - are published at
                                <a t-att-href="terms_url" style="color:#46166a;"><t t-esc="terms_label"/></a>
                                and are incorporated into this agreement by reference. They
                                may be updated from time to time. By signing below, the Host
                                acknowledges having read, understood, and agreed to those
                                Terms &amp; Conditions in effect as of the signing date.
                            </p>
                        </t>
                    </div>

                    <!-- Signatures -->
                    <table style="width:100%; margin-top:48px; font-size:13px;">
                        <tr>
                            <td style="width:62%; border-bottom:1px solid #000; padding:0 8px 2px 0;"> </td>
                            <td style="width:3%;"> </td>
                            <td style="width:35%; border-bottom:1px solid #000; padding:0 0 2px 8px;"> </td>
                        </tr>
                        <tr>
                            <td style="padding:2px 0;">Host</td>
                            <td> </td>
                            <td style="padding:2px 0 0 8px;">Date</td>
                        </tr>
                        <tr><td colspan="3" style="height:34px;"> </td></tr>
                        <tr>
                            <td style="width:62%; border-bottom:1px solid #000; padding:0 8px 2px 0;"> </td>
                            <td style="width:3%;"> </td>
                            <td style="width:35%; border-bottom:1px solid #000; padding:0 0 2px 8px;"> </td>
                        </tr>
                        <tr>
                            <td style="padding:2px 0;">Elks Representative</td>
                            <td> </td>
                            <td style="padding:2px 0 0 8px;">Date</td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>
