<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Checklist Template form -->
    <record id="view_event_checklist_template_form" model="ir.ui.view">
        <field name="name">elks.event.checklist.template.form</field>
        <field name="model">elks.event.checklist.template</field>
        <field name="arch" type="xml">
            <form string="Event Checklist Template">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Template name..."/></h1>
                    </div>
                    <group>
                        <field name="is_default"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="item_code"/>
                            <field name="name" placeholder="Defaults to item label"/>
                            <field name="create_subtask"/>
                            <field name="default_user_id"/>
                            <field name="planned_hours"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Checklist Template list -->
    <record id="view_event_checklist_template_list" model="ir.ui.view">
        <field name="name">elks.event.checklist.template.list</field>
        <field name="model">elks.event.checklist.template</field>
        <field name="arch" type="xml">
            <list string="Checklist Templates">
                <field name="name"/>
                <field name="is_default"/>
            </list>
        </field>
    </record>

    <record id="action_event_checklist_templates" model="ir.actions.act_window">
        <field name="name">Checklist Templates</field>
        <field name="res_model">elks.event.checklist.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
