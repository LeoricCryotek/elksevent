<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "Is Catering" flag on business contacts, so they appear in the
         event "Catered By" picker. -->
    <record id="view_partner_form_is_catering" model="ir.ui.view">
        <field name="name">res.partner.form.is.catering</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="x_is_catering"
                       invisible="company_type != 'company'"/>
                <field name="x_caterer_insurance_on_file"
                       string="Insurance Certificate on File (Lodge additionally insured)"
                       invisible="not x_is_catering"/>
                <field name="x_caterer_insurance_expiry"
                       invisible="not x_is_catering"/>
                <field name="x_caterer_insurance_doc"
                       filename="x_caterer_insurance_doc_name"
                       string="Insurance Certificate"
                       invisible="not x_is_catering"/>
                <field name="x_caterer_insurance_doc_name" invisible="1"/>
            </field>
        </field>
    </record>

    <!-- "Lodge Events" smart button on the contact — see every event this
         person/business has done with the lodge. -->
    <record id="view_partner_form_lodge_events" model="ir.ui.view">
        <field name="name">res.partner.form.lodge.events</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_lodge_events" type="object"
                        class="oe_stat_button" icon="fa-calendar-check-o"
                        invisible="not x_event_count">
                    <field name="x_event_count" widget="statinfo"
                           string="Lodge Events"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
