<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================================================================
         Extend maintenance.location form with rentable venue fields
         ================================================================ -->
    <record id="view_location_form_event" model="ir.ui.view">
        <field name="name">elksevent.maintenance.location.form</field>
        <field name="model">maintenance.location</field>
        <field name="inherit_id" ref="elksmaintenance.view_maintenance_location_list"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='note']" position="after">
                <field name="x_is_rentable"/>
                <field name="x_room_rate" invisible="not x_is_rentable"/>
                <field name="x_cleaning_fee" invisible="not x_is_rentable"/>
                <field name="x_service_fee" invisible="not x_is_rentable"/>
                <field name="x_capacity" invisible="not x_is_rentable"/>
                <field name="x_product_id" invisible="not x_is_rentable"/>
            </xpath>
        </field>
    </record>

    <!-- ================================================================
         Rentable Venues list view (filtered to rentable locations)
         ================================================================ -->
    <record id="view_event_venue_list" model="ir.ui.view">
        <field name="name">elksevent.venue.list</field>
        <field name="model">maintenance.location</field>
        <field name="arch" type="xml">
            <list string="Event Venues" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="x_is_rentable"/>
                <field name="x_room_rate"/>
                <field name="x_cleaning_fee"/>
                <field name="x_service_fee"/>
                <field name="x_capacity"/>
                <field name="x_product_id" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_event_venues" model="ir.actions.act_window">
        <field name="name">Event Venues / Rooms</field>
        <field name="res_model">maintenance.location</field>
        <field name="view_mode">list</field>
        <field name="domain">[('x_is_rentable', '=', True)]</field>
        <field name="context">{'default_x_is_rentable': True}</field>
    </record>

    <record id="action_event_venues_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_event_venue_list"/>
        <field name="act_window_id" ref="action_event_venues"/>
    </record>

    <!-- ================================================================
         Lodge Settings — Event Coordinator Fee Configuration
         ================================================================ -->
    <record id="view_lodge_settings_event" model="ir.ui.view">
        <field name="name">elksevent.lodge.settings.form</field>
        <field name="model">elks.lodge.settings</field>
        <field name="inherit_id" ref="elksfrs.view_elks_lodge_settings_form"/>
        <field name="priority">60</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="x_event_currency_id" invisible="1"/>
                <group string="Event Rentals — Pricing &amp; Policy"
                       name="event_rentals_pricing">
                    <group string="Coordinator Fee">
                        <field name="x_coordinator_fee_type"/>
                        <field name="x_coordinator_fixed_rate"
                               invisible="x_coordinator_fee_type != 'fixed'"/>
                        <field name="x_coordinator_percentage"
                               invisible="x_coordinator_fee_type != 'percentage'"/>
                    </group>
                    <group string="Guest-Driven Defaults">
                        <field name="x_guests_per_bartender"/>
                        <field name="x_max_bars"/>
                        <field name="x_per_plate_cost"/>
                        <field name="x_per_plate_charge"/>
                        <field name="x_default_event_hours"/>
                        <field name="x_default_cleaning_hours"/>
                    </group>
                    <group string="Deposit &amp; Tax">
                        <field name="x_deposit_pct"/>
                        <field name="x_balance_due_days_before"/>
                        <field name="x_member_discount_pct"/>
                        <field name="x_event_tax_id"/>
                    </group>
                    <group string="Terms &amp; Checklist">
                        <field name="x_event_terms_url" widget="url"/>
                        <field name="x_event_terms_label"/>
                        <field name="x_event_checklist_template_id"/>
                        <field name="x_event_project_id"/>
                        <field name="x_event_floor_plan" widget="image"
                               class="oe_avatar"/>
                    </group>
                </group>
                <group string="Event Rentals — Default Products"
                       name="event_rentals_products">
                    <group>
                        <field name="x_facility_product_id"/>
                        <field name="x_deposit_product_id"/>
                        <field name="x_coordinator_product_id"/>
                        <field name="x_event_labor_product_id"/>
                        <field name="x_bar_product_id"/>
                        <field name="x_bartender_product_id"/>
                    </group>
                    <group>
                        <field name="x_catering_product_id"/>
                        <field name="x_linen_product_id"/>
                        <field name="x_cleaning_product_id"/>
                        <field name="x_garbage_product_id"/>
                        <field name="x_insurance_product_id"/>
                    </group>
                    <field name="x_default_quote_product_ids"
                           widget="many2many_tags"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
