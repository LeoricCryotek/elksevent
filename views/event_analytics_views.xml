<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==========================================================
         Event Performance analytics: pivot + graph over the events,
         to compare guests supported, event counts/types, and P&L by
         type / month / year.
         ========================================================== -->
    <record id="view_event_performance_pivot" model="ir.ui.view">
        <field name="name">event.performance.pivot</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <pivot string="Event Performance" sample="1">
                <field name="x_event_type" type="row"/>
                <field name="x_event_date" interval="month" type="col"/>
                <field name="x_guest_count" type="measure"/>
                <field name="x_pl_net_total" type="measure"/>
                <field name="x_total_billed" type="measure"/>
                <field name="x_profit_per_guest" type="measure"/>
                <field name="x_profit_margin_pct" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_event_performance_graph" model="ir.ui.view">
        <field name="name">event.performance.graph</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <graph string="Event Performance" type="bar" sample="1">
                <field name="x_event_type"/>
                <field name="x_pl_net_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_event_performance_list" model="ir.ui.view">
        <field name="name">event.performance.list</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <list string="Event Performance" create="false">
                <field name="x_event_date" string="Date"/>
                <field name="name" string="Event"/>
                <field name="x_event_type" string="Type"/>
                <field name="x_guest_count" string="Guests" sum="Guests"/>
                <field name="x_total_billed" string="Billed" sum="Billed"/>
                <field name="x_pl_net_total" string="Net Profit" sum="Net Profit"/>
                <field name="x_profit_per_guest" string="Profit/Guest"
                       avg="Avg Profit/Guest"/>
                <field name="x_profit_margin_pct" string="Margin %"
                       avg="Avg Margin %" widget="float"
                       digits="[16,1]"/>
                <field name="x_currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Search: filters + group-bys for period / type slicing. -->
    <record id="view_event_performance_search" model="ir.ui.view">
        <field name="name">event.performance.search</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <search string="Event Performance">
                <field name="name"/>
                <field name="x_event_type"/>
                <filter name="this_year" string="This Year"
                        domain="[('x_event_date','&gt;=', (context_today().replace(month=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="this_month" string="This Month"
                        domain="[('x_event_date','&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="past" string="Past Events"
                        domain="[('x_event_date','&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="grp_type" string="Event Type"
                        context="{'group_by': 'x_event_type'}"/>
                <filter name="grp_month" string="Event Month"
                        context="{'group_by': 'x_event_date:month'}"/>
                <filter name="grp_year" string="Event Year"
                        context="{'group_by': 'x_event_date:year'}"/>
            </search>
        </field>
    </record>

    <record id="action_event_performance" model="ir.actions.act_window">
        <field name="name">Event Performance</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('x_is_event', '=', True)]</field>
        <field name="search_view_id" ref="view_event_performance_search"/>
        <field name="context">{'search_default_grp_type': 1}</field>
    </record>

    <record id="action_event_performance_pivot_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_event_performance_pivot"/>
        <field name="act_window_id" ref="action_event_performance"/>
    </record>
    <record id="action_event_performance_graph_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="20"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_event_performance_graph"/>
        <field name="act_window_id" ref="action_event_performance"/>
    </record>
    <record id="action_event_performance_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="30"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_event_performance_list"/>
        <field name="act_window_id" ref="action_event_performance"/>
    </record>

    <menuitem id="menu_event_performance"
              name="Event Performance"
              parent="menu_event_reports"
              action="action_event_performance"
              sequence="5"/>
</odoo>
