<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Cost Types: editable list (add/rename/reorder like Rooms/Venues) -->
    <record id="view_event_cost_type_list" model="ir.ui.view">
        <field name="name">elks.event.cost.type.list</field>
        <field name="model">elks.event.cost.type</field>
        <field name="arch" type="xml">
            <list string="Event Cost Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="taxable"/>
                <field name="is_labor"/>
                <field name="code" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_event_cost_type_form" model="ir.ui.view">
        <field name="name">elks.event.cost.type.form</field>
        <field name="model">elks.event.cost.type</field>
        <field name="arch" type="xml">
            <form string="Event Cost Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="is_labor"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="code"
                               help="Internal key for built-in types; leave blank for your own."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_event_cost_types" model="ir.actions.act_window">
        <field name="name">Cost Types</field>
        <field name="res_model">elks.event.cost.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
