<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Top-level app menu -->
    <menuitem id="menu_elksevent_root"
              name="Elks Events"
              sequence="58"
              web_icon="elksevent,static/description/icon.png"
              groups="elksevent.group_event_coordinator,elksevent.group_event_dept_manager"/>

    <!-- Bookings -->
    <menuitem id="menu_event_bookings"
              name="All Bookings"
              parent="menu_elksevent_root"
              action="action_event_bookings"
              sequence="10"/>

    <menuitem id="menu_event_board_queue"
              name="Board Approval Queue"
              parent="menu_elksevent_root"
              action="action_event_board_queue"
              groups="elksevent.group_event_coordinator"
              sequence="20"/>

    <!-- Reports -->
    <menuitem id="menu_event_reports"
              name="Reports"
              parent="menu_elksevent_root"
              groups="elksevent.group_event_coordinator"
              sequence="30"/>

    <menuitem id="menu_event_board_agenda"
              name="Board Agenda (Present to Board)"
              parent="menu_event_reports"
              action="action_server_board_agenda_print"
              sequence="5"/>

    <menuitem id="menu_event_board_agenda_email"
              name="Email Board Agenda"
              parent="menu_event_reports"
              action="action_server_board_agenda_email"
              sequence="6"/>

    <menuitem id="menu_event_pl_report"
              name="Event P&amp;L Report"
              parent="menu_event_reports"
              action="action_event_pl_wizard"
              sequence="10"/>

    <menuitem id="menu_event_assessor_report"
              name="Assessor / UBI Income"
              parent="menu_event_reports"
              action="action_event_assessor_wizard"
              sequence="20"/>

    <!-- Configuration -->
    <menuitem id="menu_event_config"
              name="Configuration"
              parent="menu_elksevent_root"
              groups="elksevent.group_event_coordinator"
              sequence="90"/>

    <menuitem id="menu_event_venues"
              name="Rooms / Venues"
              parent="menu_event_config"
              action="action_event_venues"
              sequence="10"/>

    <menuitem id="menu_event_checklist_templates"
              name="Checklist Templates"
              parent="menu_event_config"
              action="action_event_checklist_templates"
              sequence="20"/>

    <menuitem id="menu_event_cost_types"
              name="Event Costs"
              parent="menu_event_config"
              action="action_event_cost_types"
              sequence="30"/>

    <!-- Shortcut to the FRS Lodge Settings (event fees, rates, tax, etc.),
         which also live under Elks Charity > Configuration > Lodge Settings. -->
    <menuitem id="menu_event_lodge_settings"
              name="Lodge Settings (FRS)"
              parent="menu_event_config"
              action="elksfrs.action_lodge_settings_singleton"
              sequence="40"/>

</odoo>
