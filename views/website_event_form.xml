<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Public Event Request Form ===== -->
    <template id="website_event_request_form" name="Request an Event Booking">
        <t t-call="website.layout">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-8">

                        <h2 class="mb-4">
                            <i class="fa fa-calendar me-2"/>
                            Request an Event Booking
                        </h2>
                        <p class="text-muted mb-4">
                            Fill out this form to request a facility booking.
                            All event requests require board approval before
                            confirmation.  A deposit will be required.
                        </p>

                        <form action="/event-request/submit" method="post"
                              enctype="multipart/form-data"
                              class="card shadow-sm">
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>

                            <div class="card-body">

                                <!-- Contact info -->
                                <h5 class="fw-bold mb-3">Your Information</h5>
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label">
                                            Name <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" name="customer_name"
                                               class="form-control" required="required"
                                               placeholder="John Smith"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">
                                            Email <span class="text-danger">*</span>
                                        </label>
                                        <input type="email" name="customer_email"
                                               class="form-control" required="required"
                                               placeholder="john@example.com"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Phone</label>
                                        <input type="tel" name="customer_phone"
                                               class="form-control"
                                               placeholder="(208) 555-1234"/>
                                    </div>
                                </div>

                                <hr/>

                                <!-- Event details -->
                                <h5 class="fw-bold mb-3">Event Details</h5>

                                <div class="mb-3">
                                    <label class="form-label">
                                        Event Name <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" name="event_name"
                                           class="form-control" required="required"
                                           placeholder="Smith Wedding Reception"/>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label">
                                            Event Type <span class="text-danger">*</span>
                                        </label>
                                        <select name="event_type" class="form-select"
                                                required="required">
                                            <option value="wedding">Wedding / Reception</option>
                                            <option value="birthday">Birthday Party</option>
                                            <option value="anniversary">Anniversary</option>
                                            <option value="corporate">Corporate Event</option>
                                            <option value="fundraiser">Fundraiser</option>
                                            <option value="memorial">Memorial / Celebration of Life</option>
                                            <option value="meeting">Meeting / Conference</option>
                                            <option value="holiday">Holiday Party</option>
                                            <option value="other">Other</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">
                                            Expected Guests <span class="text-danger">*</span>
                                        </label>
                                        <input type="number" name="guest_count"
                                               class="form-control" required="required"
                                               min="1" placeholder="50"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Preferred Venue</label>
                                        <select name="venue_id" class="form-select">
                                            <option value="">-- No preference --</option>
                                            <t t-foreach="venues" t-as="v">
                                                <option t-att-value="v.id">
                                                    <t t-esc="v.name"/>
                                                    <t t-if="v.x_capacity">
                                                        (up to <t t-esc="v.x_capacity"/> guests)
                                                    </t>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label">
                                            Event Date <span class="text-danger">*</span>
                                        </label>
                                        <input type="date" name="event_date"
                                               class="form-control" required="required"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Start Time</label>
                                        <input type="time" name="start_time"
                                               class="form-control"
                                               placeholder="18:00"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">End Time</label>
                                        <input type="time" name="end_time"
                                               class="form-control"
                                               placeholder="22:00"/>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Event Description</label>
                                    <textarea name="event_description" rows="3"
                                              class="form-control"
                                              placeholder="Tell us about your event..."/>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Special Requests</label>
                                    <textarea name="special_requests" rows="2"
                                              class="form-control"
                                              placeholder="AV equipment, decorations, catering preferences..."/>
                                </div>

                                <div class="alert alert-info mt-3" role="alert">
                                    <i class="fa fa-info-circle me-1"/>
                                    <strong>Please note:</strong> All event requests
                                    are subject to board approval.  A deposit will be
                                    required upon confirmation.  We will contact you
                                    within 3 business days.
                                </div>
                            </div>

                            <div class="card-footer text-end">
                                <button type="submit"
                                        class="btn btn-primary btn-lg">
                                    <i class="fa fa-paper-plane me-2"/>
                                    Submit Request
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ===== Thank You Page ===== -->
    <template id="website_event_request_thanks" name="Event Request Submitted">
        <t t-call="website.layout">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-6 text-center">
                        <i class="fa fa-check-circle text-success"
                           style="font-size: 5rem;"/>
                        <h2 class="mt-3">Thank You!</h2>
                        <p class="lead mt-3">
                            Your event request has been submitted.
                            We will contact you within 3 business days.
                        </p>
                        <div class="card mt-4">
                            <div class="card-body text-start">
                                <p class="mb-1">
                                    <strong>Reference:</strong> #<t t-esc="task.id"/>
                                </p>
                                <p class="mb-1">
                                    <strong>Event:</strong>
                                    <t t-esc="task.name"/>
                                </p>
                                <p class="mb-1" t-if="task.x_event_date">
                                    <strong>Date:</strong>
                                    <t t-esc="task.x_event_date"/>
                                </p>
                                <p class="mb-1" t-if="task.x_guest_count">
                                    <strong>Guests:</strong>
                                    <t t-esc="task.x_guest_count"/>
                                </p>
                                <p class="mb-0" t-if="task.x_customer_name">
                                    <strong>Contact:</strong>
                                    <t t-esc="task.x_customer_name"/>
                                </p>
                            </div>
                        </div>
                        <a href="/event-request" class="btn btn-outline-primary mt-4">
                            <i class="fa fa-plus me-1"/>
                            Submit Another Request
                        </a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ===== Error Page ===== -->
    <template id="website_event_request_error" name="Event Request Error">
        <t t-call="website.layout">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-6 text-center">
                        <i class="fa fa-exclamation-triangle text-warning"
                           style="font-size: 5rem;"/>
                        <h2 class="mt-3">Something went wrong</h2>
                        <p class="lead mt-3">
                            <t t-esc="error"/>
                        </p>
                        <a href="/event-request" class="btn btn-primary mt-3">
                            Try Again
                        </a>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
