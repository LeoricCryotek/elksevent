<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1099 onboarding details on the recruitment applicant, plus a button to
         create the employee (marked 1099) once approved. -->
    <record id="view_hr_applicant_form_1099" model="ir.ui.view">
        <field name="name">hr.applicant.form.1099</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="x_is_1099" invisible="1"/>
                <button name="action_create_1099_employee" type="object"
                        string="Create 1099 Employee" class="btn-primary"
                        invisible="not x_is_1099"/>
                <button name="action_print_w9_official" type="object"
                        string="Print W-9" class="btn-secondary"
                        invisible="not x_is_1099"/>
                <button name="action_print_i9_official" type="object"
                        string="Print I-9" class="btn-secondary"
                        invisible="not x_is_1099"/>
                <button name="action_print_employment_file" type="object"
                        string="Print File" class="btn-secondary"
                        invisible="not x_is_1099"
                        help="One PDF for the records folder: the filled W-9, the filled I-9, and the uploaded photo ID and SSN / work-authorization document."/>
                <field name="x_is_employment_app" invisible="1"/>
                <button name="action_create_employment_employee" type="object"
                        string="Create Employee" class="btn-primary"
                        invisible="not x_is_employment_app"/>
                <button name="action_print_employment_packet" type="object"
                        string="Print Application Packet" class="btn-secondary"
                        invisible="not x_is_employment_app"
                        help="Print the full packet: Employment Application, I-9 Section 1, W-4, and Direct Deposit."/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="1099 Onboarding" name="onboarding_1099"
                      invisible="not x_is_1099">
                    <group>
                        <group string="Identity / W-9">
                            <field name="x_first_name"/>
                            <field name="x_middle_initial"/>
                            <field name="x_last_name"/>
                            <field name="x_other_last_names"/>
                            <field name="x_legal_name"/>
                            <field name="x_dob"/>
                            <field name="x_business_name"/>
                            <field name="x_tin_type"/>
                            <field name="x_ssn" password="True"/>
                            <field name="x_w9_tax_class"/>
                            <field name="x_w9_llc_class"
                                   invisible="x_w9_tax_class != 'llc'"
                                   required="x_w9_tax_class == 'llc'"/>
                            <field name="x_w9_other_desc"
                                   invisible="x_w9_tax_class != 'other'"
                                   required="x_w9_tax_class == 'other'"/>
                            <field name="x_not_backup_withholding"/>
                        </group>
                        <group string="Address">
                            <field name="x_addr_street"/>
                            <field name="x_addr_apt"/>
                            <field name="x_addr_city"/>
                            <field name="x_addr_state"/>
                            <field name="x_addr_zip"/>
                        </group>
                        <group string="Work Authorization (I-9)">
                            <field name="x_work_auth"/>
                            <field name="x_uscis_number"
                                   invisible="x_work_auth not in ('permanent_resident','authorized_alien')"/>
                            <field name="x_i94_number"
                                   invisible="x_work_auth != 'authorized_alien'"/>
                            <field name="x_foreign_passport"
                                   invisible="x_work_auth != 'authorized_alien'"/>
                            <field name="x_work_auth_expiry"
                                   invisible="x_work_auth != 'authorized_alien'"/>
                        </group>
                        <group string="Attestation">
                            <field name="x_i9_signed"/>
                            <field name="x_signature_name"/>
                            <field name="x_signature_date"/>
                        </group>
                    </group>
                    <separator string="Uploaded Documents"/>
                    <group>
                        <field name="x_id_doc" filename="x_id_doc_name"
                               string="Photo ID (front)"/>
                        <field name="x_id_doc_name" invisible="1"/>
                        <field name="x_id_doc_back" filename="x_id_doc_back_name"
                               string="Photo ID (back)"/>
                        <field name="x_id_doc_back_name" invisible="1"/>
                        <field name="x_work_doc_type"/>
                        <field name="x_ssn_doc" filename="x_ssn_doc_name"
                               string="Work-Authorization Document"/>
                        <field name="x_ssn_doc_name" invisible="1"/>
                    </group>
                </page>
                <page string="Employment Application" name="employment_app"
                      invisible="not x_is_employment_app">
                    <group>
                        <group string="Applicant">
                            <field name="x_first_name"/>
                            <field name="x_middle_initial"/>
                            <field name="x_last_name"/>
                            <field name="x_dob"/>
                            <field name="x_ssn" password="True"/>
                            <field name="x_position_applied"/>
                            <field name="x_date_available"/>
                            <field name="x_desired_salary"/>
                        </group>
                        <group string="Address / Eligibility">
                            <field name="x_addr_street"/>
                            <field name="x_addr_apt"/>
                            <field name="x_addr_city"/>
                            <field name="x_addr_state"/>
                            <field name="x_addr_zip"/>
                            <field name="x_is_citizen"/>
                            <field name="x_worked_here_before"/>
                            <field name="x_worked_here_when"
                                   invisible="not x_worked_here_before"/>
                            <field name="x_felony"/>
                            <field name="x_felony_explain"
                                   invisible="not x_felony"/>
                        </group>
                    </group>
                    <separator string="Education"/>
                    <field name="x_education_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="level"/>
                            <field name="school"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="graduated"/>
                            <field name="degree"/>
                        </list>
                    </field>
                    <separator string="References"/>
                    <field name="x_reference_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="relationship"/>
                            <field name="company"/>
                            <field name="phone"/>
                        </list>
                    </field>
                    <separator string="Previous Employment"/>
                    <field name="x_prior_employer_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="company"/>
                            <field name="title"/>
                            <field name="supervisor"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="reason_leaving"/>
                            <field name="may_contact"/>
                        </list>
                    </field>
                    <group>
                        <group string="Military Service">
                            <field name="x_mil_branch"/>
                            <field name="x_mil_from"/>
                            <field name="x_mil_to"/>
                            <field name="x_mil_rank"/>
                            <field name="x_mil_discharge"/>
                            <field name="x_mil_explain"/>
                        </group>
                        <group string="Work Authorization (I-9)">
                            <field name="x_work_auth"/>
                            <field name="x_uscis_number"/>
                            <field name="x_work_auth_expiry"/>
                        </group>
                    </group>
                    <group>
                        <group string="Federal Withholding (W-4)">
                            <field name="x_w4_filing"/>
                            <field name="x_w4_multiple_jobs"/>
                            <field name="x_w4_dependents_amt"/>
                            <field name="x_w4_other_income"/>
                            <field name="x_w4_deductions"/>
                            <field name="x_w4_extra_withholding"/>
                        </group>
                        <group string="Direct Deposit">
                            <field name="x_dd_bank_name"/>
                            <field name="x_dd_bank_address"/>
                            <field name="x_dd_account_type"/>
                            <field name="x_dd_routing" password="True"/>
                            <field name="x_dd_account" password="True"/>
                            <field name="x_dd_authorized"/>
                        </group>
                    </group>
                    <group string="Signature">
                        <field name="x_i9_signed"/>
                        <field name="x_signature_name"/>
                        <field name="x_signature_date"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Pay category + 1099 tax fields on the employee record. -->
    <record id="view_employee_form_pay_category" model="ir.ui.view">
        <field name="name">hr.employee.form.pay.category</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <field name="x_is_event_custodial_mgr" position="after">
                <field name="x_pay_category"/>
                <field name="x_tin_type" invisible="x_pay_category == 'w2'"/>
                <field name="x_tin_last4" invisible="x_pay_category == 'w2'"/>
                <field name="x_w9_on_file" invisible="x_pay_category == 'w2'"/>
            </field>
        </field>
    </record>
</odoo>
