<?xml version="1.0" encoding="UTF-8"?>
<!-- =========================================================================
     HUMAN: After-action emails. (1) The customer gets a feedback-survey link
     when their event moves to After Action. (2) The coordinator gets a note
     when the customer finishes the survey. The survey link is passed in via
     context (survey_link) by project_task._send_customer_survey.
     AI: both on project.task; noupdate so wording edits survive upgrades.
     ========================================================================= -->
<odoo>
    <data noupdate="1">

        <record id="mail_template_customer_survey" model="mail.template">
            <field name="name">Event: Customer Feedback Survey</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="subject">How was your event? — {{ object.name }}</field>
            <field name="email_from">{{ (user.email_formatted or '') }}</field>
            <field name="email_to">{{ object.x_customer_email }}</field>
            <field name="body_html" type="html">
                <div style="font-family:Arial,sans-serif;">
                    <p>Hi <t t-out="object.x_customer_name or 'there'"/>,</p>
                    <p>Thank you for choosing the Lewiston Elks Lodge for
                       <strong t-out="object.name"/>. We'd love to hear how it
                       went so we can keep improving.</p>
                    <p>
                        <a t-att-href="ctx.get('survey_link')"
                           style="background:#46166a;color:#fff;padding:10px 18px;
                                  text-decoration:none;border-radius:4px;
                                  display:inline-block;">Take the short survey</a>
                    </p>
                    <p style="font-size:12px;color:#666;">If the button doesn't
                       work, copy this link into your browser:<br/>
                       <t t-out="ctx.get('survey_link')"/></p>
                    <p>— Lewiston Elks Lodge #896</p>
                </div>
            </field>
        </record>

        <record id="mail_template_survey_done_coordinator" model="mail.template">
            <field name="name">Event: Customer Feedback Received</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="subject">Customer feedback received — {{ object.name }}</field>
            <field name="email_from">{{ (user.email_formatted or '') }}</field>
            <field name="email_to">{{ ctx.get('coordinator_email') }}</field>
            <field name="body_html" type="html">
                <div style="font-family:Arial,sans-serif;">
                    <p>The customer completed the feedback survey for
                       <strong t-out="object.name"/><t t-if="object.x_event_date">
                       (<t t-out="object.x_event_date"/>)</t>.</p>
                    <p>Open the event to review their responses on the
                       After-Action tab.</p>
                    <p>— Elks Events</p>
                </div>
            </field>
        </record>

    </data>
</odoo>
