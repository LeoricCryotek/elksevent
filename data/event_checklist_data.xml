            <field name="item_code">garbage</field>
            <field name="name">Garbage removal</field>
        </record>
        <record id="checklist_line_bars" model="elks.event.checklist.template.line">
            <field name="template_id" ref="checklist_template_standard"/>
            <field name="sequence">100</field>
            <field name="item_code">bars</field>
            <field name="name">Staff the bar(s)</field>
        </record>
        <record id="checklist_line_beer_tub" model="elks.event.checklist.template.line">
            <field name="template_id" ref="checklist_template_standard"/>
            <field name="sequence">110</field>
            <field name="item_code">beer_tub</field>
            <field name="name">Stock beer tub</field>
        </record>
        <record id="checklist_line_decorations" model="elks.event.checklist.template.line">
            <field name="template_id" ref="checklist_template_standard"/>
