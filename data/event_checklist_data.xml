        </record>
        <record id="checklist_line_setup" model="elks.event.checklist.template.line">
            <field name="template_id" ref="checklist_template_standard"/>
            <field name="sequence">140</field>
            <field name="item_code">setup</field>
            <field name="name">Event setup</field>
        </record>
        <record id="checklist_line_takedown" model="elks.event.checklist.template.line">
            <field name="template_id" ref="checklist_template_standard"/>
            <field name="sequence">150</field>
