<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- noupdate: this is a starting template the lodge will customize;
         don't overwrite their edits on upgrade. -->
    <data noupdate="1">

        <record id="checklist_template_standard" model="elks.event.checklist.template">
            <field name="name">Standard Event Checklist</field>
            <field name="is_default">True</field>
        </record>

        <record id="checklist_line_tables" model="elks.event.checklist.template.line">
            <field name="template_id" ref="checklist_template_standard"/>
            <field name="sequence">10</field>
            <field name="item_code">tables</field>
            <field name="name">Set up tables</field>
        </record>
        <record id="checklist_line_chairs" model="elks.event.checklist.template.line">
            <field name="template_id" ref="checklist_template_standard"/>
            <field name="sequence">20</field>
            <field name="item_code">chairs</field>
            <field name="name">Set up chairs</field>
        </record>
        <record id="checklist_line_podium" model="elks.event.checklist.template.line">
            <field name="template_id" ref="checklist_template_standard"/>
            <field name="sequence">30</field>
            <field name="item_code">podium</field>
            <field name="name">Place podium</field>
        </record>
        <record id="checklist_line_sound" model="elks.event.checklist.template.line">
            <field name="template_id" ref="checklist_template_standard"/>
            <field name="sequence">40</field>
            <field name="item_code">sound</field>
            <field name="name">Set up sound system</field>
        </record>
        <record id="checklist_line_microphone" model="elks.event.checklist.template.line">
            <field name="template_id" ref="checklist_template_standard"/>
            <field name="sequence">50</field>
            <field name="item_code">microphone</field>
            <field name="name">Provide microphone</field>
        </record>
        <record id="checklist_line_linen" model="elks.event.checklist.template.line">
            <field name="template_id" ref="checklist_template_standard"/>
            <field name="sequence">60</field>
            <field name="item_code">linen</field>
            <field name="name">Set up linens</field>
        </record>
        <record id="checklist_line_insurance" model="elks.event.checklist.template.line">
            <field name="template_id" ref="checklist_template_standard"/>
            <field name="sequence">70</field>
            <field name="item_code">insurance</field>
            <field name="name">Collect insurance certificate</field>
        </record>
        <record id="checklist_line_kitchen" model="elks.event.checklist.template.line">
            <field name="template_id" ref="checklist_template_standard"/>
