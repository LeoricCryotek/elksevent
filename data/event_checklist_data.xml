            <field name="name">Kitchen / food prep</field>
        </record>
        <record id="checklist_line_food_catered" model="elks.event.checklist.template.line">
            <field name="template_id" ref="checklist_template_standard"/>
            <field name="sequence">170</field>
            <field name="item_code">food_catered</field>
            <field name="name">Verify caterer license &amp; insurance</field>
        </record>
        <record id="checklist_line_extras" model="elks.event.checklist.template.line">
            <field name="template_id" ref="checklist_template_standard"/>
            <field name="sequence">180</field>
            <field name="item_code">extras</field>
            <field name="name">Provide extras</field>
        </record>

    </data>
</odoo>
