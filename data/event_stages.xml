<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             Default Event Bookings Project (placeholder — Elk Year
             projects are created automatically by cron)
             ============================================================ -->
        <record id="project_event_bookings" model="project.project">
            <field name="name">Events</field>
            <field name="description">Facility event booking requests, board approval, room billing, and P&amp;L tracking.</field>
            <field name="privacy_visibility">portal</field>
            <field name="allow_task_dependencies">True</field>
            <field name="x_is_event_project">True</field>
        </record>

        <!-- ============================================================
             Event Pipeline Stages
             ============================================================ -->
        <record id="stage_new" model="project.task.type">
            <field name="name">New</field>
            <field name="sequence">10</field>
            <field name="project_ids" eval="[(4, ref('project_event_bookings'))]"/>
        </record>

        <record id="stage_contacted" model="project.task.type">
            <field name="name">Contacted</field>
            <field name="sequence">20</field>
            <field name="project_ids" eval="[(4, ref('project_event_bookings'))]"/>
        </record>

        <record id="stage_submitted_to_board" model="project.task.type">
            <field name="name">Submitted to Board</field>
            <field name="sequence">30</field>
            <field name="project_ids" eval="[(4, ref('project_event_bookings'))]"/>
        </record>

        <record id="stage_booked" model="project.task.type">
            <field name="name">Booked</field>
            <field name="sequence">40</field>
            <field name="project_ids" eval="[(4, ref('project_event_bookings'))]"/>
        </record>

        <record id="stage_after_action" model="project.task.type">
            <field name="name">After Action</field>
            <field name="sequence">50</field>
            <field name="project_ids" eval="[(4, ref('project_event_bookings'))]"/>
        </record>

        <record id="stage_completed" model="project.task.type">
            <field name="name">Completed</field>
            <field name="sequence">60</field>
            <field name="fold">True</field>
            <field name="project_ids" eval="[(4, ref('project_event_bookings'))]"/>
        </record>

        <record id="stage_cancelled" model="project.task.type">
            <field name="name">Cancelled</field>
            <field name="sequence">70</field>
            <field name="fold">True</field>
            <field name="project_ids" eval="[(4, ref('project_event_bookings'))]"/>
        </record>

    </data>
</odoo>
