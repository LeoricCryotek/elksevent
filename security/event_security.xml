<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- Privilege row on the User form Access Rights tab -->
        <record id="res_groups_privilege_elksevent" model="res.groups.privilege">
            <field name="name">Elks Events</field>
            <field name="category_id" ref="base.module_category_services_project"/>
            <field name="sequence">75</field>
        </record>

        <!-- Event Coordinator — can manage event bookings (requester) -->
        <record id="group_event_coordinator" model="res.groups">
            <field name="name">Event Coordinator</field>
            <field name="privilege_id" ref="res_groups_privilege_elksevent"/>
            <field name="comment">
                Can create and manage event booking requests, fill out the
                checklist, edit the quote, manage rooms, process deposits and
                invoices, and SUBMIT events for Board review.  Cannot self-approve.
            </field>
            <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
        </record>

        <!-- Event Officer — the full approval + override role. Includes
             everything a Coordinator can do, PLUS Board approval, Floor vote
             recording, budget override, and double-booking override.
             Typically the Lodge Secretary / Exalted Ruler / Trustees. -->
        <record id="group_event_officer" model="res.groups">
            <field name="name">Event Officer</field>
            <field name="privilege_id" ref="res_groups_privilege_elksevent"/>
            <field name="sequence">10</field>
            <field name="comment">
                Full event authority: approve/reject at the Board, record the
                Floor vote, approve over-budget purchase orders, and override
                double-booking conflicts — plus everything an Event Coordinator
                can do. Typically Lodge Officers (Secretary / Exalted Ruler).
            </field>
            <field name="implied_ids" eval="[(4, ref('group_event_coordinator'))]"/>
        </record>

        <!-- Event Department Manager — Bar / Kitchen / Custodial managers who
             help build quotes. They can view event bookings, log notes in the
             chatter, and enter their staffing response (counts / hours) on the
             event so the coordinator can quote quickly. NO board approval, NO
             financials, and they only see EVENT tasks (not other projects). -->
        <record id="group_event_dept_manager" model="res.groups">
            <field name="name">Event Department Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_elksevent"/>
            <field name="sequence">5</field>
            <field name="comment">
                Bar / Kitchen / Custodial managers: view event bookings, add
                notes, and enter their staffing response (staff count + hours)
                to help build quotes. No approval, no financials, scoped to
                event tasks only.
            </field>
        </record>

        <!-- Visibility: event staff see ALL event tasks (not just ones they
             follow). Group rules are OR-combined, so this GRANTS access on top
             of the base project rule. Without it, a Coordinator whose project
             membership is empty sees no events. -->
        <record id="rule_event_task_event_staff" model="ir.rule">
            <field name="name">Event tasks: visible to event coordinators</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[('x_is_event', '=', True)]</field>
            <field name="groups" eval="[(4, ref('group_event_coordinator'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>
        <record id="rule_event_task_dept_manager" model="ir.rule">
            <field name="name">Event tasks: department managers (event-only)</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[('x_is_event', '=', True)]</field>
            <field name="groups" eval="[(4, ref('group_event_dept_manager'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- The event quote is now the CUSTOMER-facing document (a single
             "Event Rental" line + tax), sent by email / viewed on the portal.
             So it must NOT be hidden from portal users any more. This rule is
             kept as a no-op (always true) rather than deleted so the id stays
             stable; standard Odoo portal rules still limit a portal user to
             their OWN orders. -->
        <record id="rule_sale_order_event_quotes_internal_only" model="ir.rule">
            <field name="name">Event quotes: customer-visible</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <!-- Portal managers only see (and act on) their own call-outs -->
        <record id="rule_callout_portal_own" model="ir.rule">
            <field name="name">Portal: own department call-outs</field>
            <field name="model_id" ref="model_elks_event_callout"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[('manager_partner_id', '=', user.partner_id.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
