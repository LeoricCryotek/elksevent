<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- Event Coordinator — can manage event bookings -->
        <record id="group_event_coordinator" model="res.groups">
            <field name="name">Event Coordinator</field>
            <field name="comment">
                Can manage event booking requests, update board approval
                status, enter financial details, manage rooms, and
                process deposits and invoices.
            </field>
            <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
        </record>

        <!-- Budget Override — can approve POs that exceed event billed total -->
        <record id="group_event_budget_override" model="res.groups">
            <field name="name">Event Budget Override</field>
            <field name="comment">
                Can approve purchase orders that would exceed the event's
                total billed amount.  Typically assigned to the Lodge
                Secretary or Exalted Ruler.
            </field>
            <field name="implied_ids" eval="[(4, ref('group_event_coordinator'))]"/>
        </record>

    </data>
</odoo>
